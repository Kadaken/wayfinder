[Desktop Entry]
Name=Wayfinder
Comment=A fast, native file manager for Linux with a docked preview pane
Exec=@BINDIR@/wayfinder %U
Icon=com.kadaken.wayfinder
Terminal=false
Type=Application
Categories=FileManager;System;Utility;
Keywords=files;file manager;preview;browser;
StartupWMClass=com.kadaken.wayfinder
Actions=new-window;
MimeType=inode/directory;application/x-gnome-saved-search;

[Desktop Action new-window]
Name=New Window
Exec=@BINDIR@/wayfinder-new-window
