[Desktop Entry]
# Not a launcher: the picker is only ever started by the portal backend. This
# entry exists so the desktop can match a picker window to Wayfinder and show
# its icon instead of a nameless placeholder. NoDisplay keeps it out of menus.
Name=Wayfinder
Comment=File chooser
Exec=/home/zito/.local/bin/wayfinder-native --pick
Icon=com.kadaken.wayfinder
Terminal=false
Type=Application
NoDisplay=true
Categories=FileManager;System;
StartupWMClass=com.kadaken.wayfinder.picker
