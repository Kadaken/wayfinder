[Desktop Entry]
Name=Wayfinder
Comment=Fast, native Linux file manager with a docked preview pane
Exec=wayfinder %U
Icon=com.kadaken.wayfinder
Terminal=false
Type=Application
Categories=System;FileManager;
Actions=new-window;
Keywords=files;file manager;preview;browser;
StartupWMClass=wayfinder
MimeType=inode/directory;

[Desktop Action new-window]
Name=New Window
Exec=wayfinder-new-window
